<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kotlin_Android_DSA_Experiment">
        <activity
            android:name=".broadcast.BroadCastMainActivity"
            android:exported="false" />
        <activity
            android:name=".audioCallManualCode.CallingMainActivity"
            android:exported="false" />
        <activity
            android:name=".audioCallManualCode.OutgoingCallManuallyActivity"
            android:exported="false" />
        <activity
            android:name=".audioCallManualCode.IncomingCallManuallyActivity"
            android:exported="false" />
        <activity
            android:name=".agroVidoeCAll.AgroVidoeCallActivity"
            android:exported="false" />
        <activity
            android:name=".aghora.AgoraCallActivity"
            android:exported="false" />

        <receiver
            android:name=".broadcast.simpleBroadcast.SimpleBroadCast"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.AIRPLANE_MODE" />
            </intent-filter>
        </receiver>



        <receiver android:name=".broadcast.simpleBroadcast.CustomBroadCast"
            android:exported="true">

            <intent-filter>
                <action android:name="com.android.experiment.CUSTOM_BROADCAST"/>
            </intent-filter>

        </receiver>




        <activity
            android:name=".splashScreen.SplashScreenActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".WelComeScreen"
            android:exported="false" />
        <activity
            android:name=".paymentGetway.googlepayUpi.GooglePayUPIActivity"
            android:exported="true"
            android:theme="@style/Theme.Kotlin_Android_DSA_Experiment" />
        <activity
            android:name=".mvvm.MVVMExActivity"
            android:exported="false"
            android:theme="@style/Theme.Kotlin_Android_DSA_Experiment" />
        <activity
            android:name=".coroutine.flow.example.FlowTestActivity"
            android:exported="true" />
        <activity
            android:name=".coroutine.andridCode.CorouitneExperimentActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <service
            android:name=".audioCallManualCode.services.MyFirebaseMessagingService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="io.agora.sdk.log.level"
            android:value="DEBUG" />
    </application>

</manifest>