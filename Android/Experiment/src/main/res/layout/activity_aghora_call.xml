<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".aghora.AgoraCallActivity">
    <!--Aghora_call-->

    <TextView
        android:id="@+id/textview_screenName_xxx"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:text="Agora Call"
        android:textColor="@color/white"
        android:textSize="@dimen/_30sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/textview_Aghora_call_action_startCall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_50sdp"
        android:background="#D834799D"
        android:paddingHorizontal="@dimen/_20sdp"
        android:paddingVertical="@dimen/_10sdp"
        android:text="Call Start"
        android:textColor="@color/white"
        android:textSize="@dimen/_20sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textview_screenName_xxx" />


    <TextView
        android:id="@+id/textview_Aghora_call_action_startVodeoCAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_50sdp"
        android:background="#D834799D"
        android:paddingHorizontal="@dimen/_20sdp"
        android:paddingVertical="@dimen/_10sdp"
        android:text="Start Video Call"
        android:textColor="@color/white"
        android:textSize="@dimen/_20sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textview_Aghora_call_action_startCall" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contraintlayout_ScreenName_xx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">



        <!-- Local Video View -->
        <FrameLayout
            android:id="@+id/local_video_view_container"
            android:layout_width="@dimen/_130sdp"
            android:layout_height="@dimen/_200sdp"
            android:background="#4B749D"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="@dimen/_20sdp" />

        <TextView
            android:id="@+id/textview_screenName_local_video"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOCAL"
            android:textColor="@color/black"
            android:textSize="@dimen/_25sdp"
            app:layout_constraintTop_toBottomOf="@id/local_video_view_container"
            app:layout_constraintStart_toStartOf="@id/local_video_view_container"
            android:layout_marginTop="@dimen/_8sdp" />

        <!-- Remote Video View -->
        <FrameLayout
            android:id="@+id/remote_video_view_container"
            android:layout_width="@dimen/_130sdp"
            android:layout_height="@dimen/_200sdp"
            android:background="#9B5252"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="@dimen/_20sdp" />

        <TextView
            android:id="@+id/textview_screenName_remoteview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REMOTE"
            android:textColor="@color/black"
            android:textSize="@dimen/_25sdp"
            app:layout_constraintTop_toBottomOf="@id/remote_video_view_container"
            app:layout_constraintEnd_toEndOf="@id/remote_video_view_container"
            android:layout_marginTop="@dimen/_8sdp" />



