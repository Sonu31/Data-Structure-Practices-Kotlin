<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<!--callDilaog-->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contraintlayout_ScreenName_xx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_30sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <TextView
            android:id="@+id/textview_callDilaog_action_callCut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Call Cut"
            android:drawableTop="@drawable/baseline_add_call_24"
            android:textColor="@color/black"
            android:textSize="@dimen/_15sdp"
       app:layout_constraintEnd_toStartOf="@+id/textview_callDilaog_action_speaker"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/textview_callDilaog_action_speaker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Call Mute"
            app:layout_constraintStart_toEndOf="@+id/textview_callDilaog_action_callCut"
            android:textColor="@color/black"
            android:textSize="@dimen/_15sdp"
            android:drawableTop="@drawable/baseline_directions_off_24"
            app:layout_constraintEnd_toStartOf="@+id/textview_callDilaog_action_callmut"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textview_callDilaog_action_callmut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Call Speaker"
            app:layout_constraintStart_toEndOf="@+id/textview_callDilaog_action_speaker"
            android:textColor="@color/black"
            android:drawableTop="@drawable/baseline_workspaces_filled_24"
            android:textSize="@dimen/_15sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>